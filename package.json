{
  "name": "image-webify",
  "displayName": "Image Webify",
  "description": "convert images (JPG, PNG, GIF, TIFF) to webp or avif formats",
  "version": "1.0.0",
  "icon": "images/icon.png",
  "repository": "https://github.com/geckod22/vsc-image-webify",
  "license": "MIT",
  "publisher": "geckod22",
  "author": {
    "name": "Armando Liccardo",
	"url": "https://github.com/geckod22",
    "email": "li.armando82@gmail.com"
  },
  "keywords": [
    "image",
    "webp",
    "avif",
	"conversion"
  ],
  "engines": {
    "vscode": "^1.109.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
	"configuration": {
    "title": "Image Webify",
	 "properties": {
		"image-webify.defaultQualityWebp": {
			"type": "integer",
			"default": 80,
			"minimum": 1,
			"maximum": 100,
			"description": "Default Quality for the conversion to webp format"
		},
		"image-webify.askForQualityWebp": {
			"type": "boolean",
			"default": true,
			"description": "If true, it asks the user the quality for each conversion. If false, always use the default value."
		},
		"image-webify.defaultQualityAvif": {
			"type": "integer",
			"default": 80,
			"minimum": 1,
			"maximum": 100,
			"description": "Default Quality for the conversion to Avif format"
		},
		"image-webify.askForQualityAvif": {
			"type": "boolean",
			"default": true,
			"description": "If true, it asks the user the quality for each conversion. If false, always use the default value."
		}
	  }
	},
    "commands": [
      {
        "command": "image-webify.convertToWebp",
        "title": "Convert to WEBP",
        "category": "Other"
      },
      {
        "command": "image-webify.convertToAvif",
        "title": "Convert to AVIF",
        "category": "Other"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "image-webify.convertToWebp",
          "when": "resourceExtname =~ /\\.(png|jpg|jpeg|gif)/ && !explorerResourceIsFolder",
          "group": "navigation"
        },
		{
          "command": "image-webify.convertToAvif",
          "when": "resourceExtname =~ /\\.(png|jpg|jpeg|gif)/ && !explorerResourceIsFolder",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.109.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.2",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0"
  },
  "dependencies": {
    "sharp": "^0.34.5"
  }
}
